# 本地开发日志（不纳入版本管理）
devlog/

# 忽略虚拟环境及项目产生的临时文件
.venv/
venv/
.idea/
.claude/
.vscode/
.trae/
__pycache__/
.DS_Store
.pytest_cache
备注笔记.txt
docs/
# 忽略log文件，但保留.gitkeep和子目录

# 忽略配置文件（但保留示例文件）
config.yaml
secrets/
.env
.env.local
.env.*.local
deploy/env/*.env
# 忽略log文件
logs/*
!logs/.gitkeep
!logs/*/
logs/*/*
!logs/*/.gitkeep
backend/backend/logs/*
!backend/backend/logs/.gitkeep
.sql
.bak
# 保留数据工厂静态文件目录、忽略内容
static_files/img/*
!static_files/img/.gitkeep
.cursor/
.github/*
!.github/workflows/
!.github/workflows/*.yml

# 忽略 allure-static 下的所有文件（运行时生成）
expand/media/allure-static/*
!expand/media/allure-static/.gitkeep

# 忽略 AI 录屏文件，但保留.gitkeep
expand/media/ai_recording/*
!expand/media/ai_recording/.gitkeep

# 忽略根目录 media 下的运行产物
media/*
!media/.gitkeep

# 忽略正式环境运行时缓存和媒体产物
Data/Cache/action_cache.json
expand/media/

# 忽略 Data/PRD 下的归档文档，但保留.gitkeep
Data/PRD/*
!Data/PRD/.gitkeep

# 忽略接口测试运行时产生的 Allure 报告文件，但保留.gitkeep文件
expand/media/api_testing/allure-results/*
!expand/media/api_testing/allure-results/.gitkeep
expand/media/api_testing/allure-reports/*
!expand/media/api_testing/allure-reports/.gitkeep
expand/media/api_testing/allure-static/*
!expand/media/api_testing/allure-static/.gitkeep

# 忽略 APP 自动化运行时产生的文件，但保留.gitkeep文件
expand/media/app_automation/allure-results/*
!expand/media/app_automation/allure-results/.gitkeep
expand/media/app_automation/allure-reports/*
!expand/media/app_automation/allure-reports/.gitkeep
expand/media/app_automation/screenshots/*
!expand/media/app_automation/screenshots/.gitkeep
# 忽略APP自动化模板文件
apps/app_automation/Template/**
!apps/app_automation/Template/

# 忽略UI自动化运行时产生的截图文件，但保留.gitkeep文件
!expand/media/ui_automation/screenshots/.gitkeep
expand/media/ui_automation/screenshots/*

# 忽略知识库上传文件，但保留.gitkeep文件
expand/media/knowledge_base/*
!expand/media/knowledge_base/.gitkeep

# 忽略知识库生成的数据库文件
backend/expand/chroma_db/*
expand/chroma_db/*
!expand/chroma_db/.gitkeep

# 忽略导入的测试用例文件，但保留.gitkeep文件
expand/media/testcase_imports/*
!expand/media/testcase_imports/.gitkeep

# 忽略前端文件
frontend/node_modules/
frontend/.DS_Store
frontend/*.log
frontend/dist/

# Local Chromium HEVC build artifacts are distributed outside Git.
deploy/chromium-hevc/artifacts/*
!deploy/chromium-hevc/artifacts/.gitkeep

# reference:
pyapitest/
pyuitest/