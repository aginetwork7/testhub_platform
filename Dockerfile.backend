FROM python:3.12-slim

ARG TORCH_INDEX_URL=""
ARG TORCH_PACKAGES=""
ARG TARGETARCH
ARG HEVC_CHROMIUM_VERSION="151.0.7922.173-1~deb13u1+hevc1"

ENV PLAYWRIGHT_CHROMIUM_PATH=/usr/lib/chromium/chromium

WORKDIR /app

COPY deploy/chromium-hevc/artifacts/ /tmp/chromium-hevc/

# 安装系统级依赖 (MySQL驱动编译依赖 + Playwright依赖)
RUN set -eux; \
    test "$TARGETARCH" = "arm64"; \
    cd /tmp/chromium-hevc; \
    sha256sum -c SHA256SUMS; \
    for package_name in chromium chromium-common chromium-sandbox; do \
        package_path="${package_name}_${HEVC_CHROMIUM_VERSION}_arm64.deb"; \
        test "$(dpkg-deb -f "$package_path" Package)" = "$package_name"; \
        test "$(dpkg-deb -f "$package_path" Version)" = "$HEVC_CHROMIUM_VERSION"; \
        test "$(dpkg-deb -f "$package_path" Architecture)" = "arm64"; \
    done; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential default-libmysqlclient-dev git curl netcat-openbsd \
        android-tools-adb ffmpeg \
        "./chromium-common_${HEVC_CHROMIUM_VERSION}_arm64.deb" \
        "./chromium-sandbox_${HEVC_CHROMIUM_VERSION}_arm64.deb" \
        "./chromium_${HEVC_CHROMIUM_VERSION}_arm64.deb"; \
    test -x /usr/lib/chromium/chromium; \
    /usr/lib/chromium/chromium --version | grep -F "Chromium 151.0.7922.173"; \
    rm -rf /tmp/chromium-hevc /var/lib/apt/lists/*

# 安装 Python 依赖（清华镜像加速，官方 PyPI 兜底）
# cache mount 让 pip 缓存跨构建持久化，网络断连重试时已下载的包直接从缓存读取
COPY backend/requirements.txt .

# 可选：按目标设备预装 torch/torchvision。
# 对 Nvidia Spark 这类 GPU 设备，不应强制使用 CPU-only 轮子；
# 如需绑定设备对应的 PyTorch 源，可在构建时传入 TORCH_INDEX_URL / TORCH_PACKAGES。
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ -n "$TORCH_PACKAGES" ]; then \
        if [ -n "$TORCH_INDEX_URL" ]; then \
            pip install --index-url "$TORCH_INDEX_URL" $TORCH_PACKAGES; \
        else \
            pip install $TORCH_PACKAGES; \
        fi; \
    fi

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install -r requirements.txt \
    --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    --extra-index-url https://pypi.org/simple \
    --trusted-host pypi.tuna.tsinghua.edu.cn \
    --retries 5 --timeout 300

# 安装 Playwright 浏览器内核 (用于UI自动化)
RUN playwright install --with-deps chromium

# 只复制 backend 目录内容（manage.py 在 /app/manage.py）
COPY backend/ .

EXPOSE 8000
